apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
type: Opaque
stringData:
  GITHUB_WEBHOOK_SECRET: "replace-with-webhook-secret"
  GITHUB_APP_ID: "replace-with-github-app-id"
  GITHUB_APP_PRIVATE_KEY: |
    -----BEGIN RSA PRIVATE KEY-----
    replace-with-github-app-private-key
    -----END RSA PRIVATE KEY-----
  OPENAI_API_KEY: "sk-replace-with-openai-api-key"
  LANGFUSE_PUBLIC_KEY: "pk-lf-replace-with-langfuse-public-key"
  LANGFUSE_SECRET_KEY: "sk-lf-replace-with-langfuse-secret-key"
  DATABASE_URL: "postgresql+asyncpg://user:password@postgres:5432/codereviewer"
